<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BHLI-TMOI Restaurant</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{
    --charcoal-950:#171512;
    --charcoal-800:#221f1b;
    --charcoal-700:#2c2822;
    --paper:#ffffff;
    --paper-dim:#ececec;
    --box-white:#ffffff;
    --box-dim:#eef0f2;
    --ink:#2b2620;
    --copper:#b8703f;
    --copper-light:#d69463;
    --sage:#7c9473;
    --amber:#d3a24c;
    --rust:#b5524b;
    --line:rgba(241,233,218,0.12);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse at 20% -10%, #123a6b 0%, transparent 55%),
      #071c38;
    color:var(--paper);
    font-family:'IBM Plex Mono', monospace;
    min-height:100vh;
  }
  .display{font-family:'Oswald', sans-serif; text-transform:uppercase; letter-spacing:0.04em;}

  /* ---------- Header ---------- */
  header{
    padding:36px 6vw 28px;
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:16px;
    border-bottom:1px solid var(--line);
  }
  header .brand h1{
    font-size:clamp(28px,4vw,42px);
    font-weight:700;
    margin:0;
    color:var(--paper);
  }
  header .brand h1 span{color:var(--copper-light);}
  header .brand p{
    margin:4px 0 0;
    font-size:12.5px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:#a89a80;
  }
  #clock{
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    color:#a89a80;
    text-align:right;
    display:flex;
    align-items:baseline;
    gap:14px;
  }
  #clock strong{color:var(--paper); font-size:15px; letter-spacing:0.05em;}

  /* ---------- Metrics: tally stubs ---------- */
  .metrics{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:12px;
    padding:24px 6vw 8px;
  }
  @media (min-width:640px){
    .metrics{grid-template-columns:repeat(auto-fit, minmax(180px,1fr));}
  }
  .stub{
    position:relative;
    background:var(--box-white);
    border:1px solid rgba(7,28,56,0.12);
    border-radius:4px;
    padding:14px 12px;
    display:flex;
    align-items:center;
    gap:10px;
    min-width:0;
  }
  .stub::before{
    content:'';
    width:14px;height:14px;
    border-radius:50%;
    background:var(--box-dim);
    border:1px solid rgba(7,28,56,0.15);
    flex:none;
  }
  .stub .num{
    font-family:'Oswald',sans-serif;
    font-size:22px;
    font-weight:600;
    color:var(--copper);
    line-height:1;
  }
  .stub .lbl{
    font-size:9.5px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:#0a2647;
    margin-top:4px;
  }

  /* ---------- Waiter board ---------- */
  .boards-row{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(280px,1fr));
    gap:16px;
    margin:20px 6vw 0;
  }
  .waiter-board{
    background:var(--box-white);
    border:1px solid rgba(7,28,56,0.12);
    border-radius:4px;
    padding:16px 18px 18px;
  }
  .waiter-board h3{
    font-family:'Oswald',sans-serif;
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:#5b5140;
    margin:0 0 12px;
  }
  .waiter-list{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }
  .waiter-chip{
    display:flex;
    align-items:center;
    gap:8px;
    background:var(--box-dim);
    border:1px solid rgba(7,28,56,0.1);
    border-radius:3px;
    padding:8px 12px;
  }
  .waiter-chip .w-name{
    font-family:'IBM Plex Mono',monospace;
    font-size:12.5px;
    color:var(--ink);
  }
  .waiter-chip .w-count{
    font-family:'Oswald',sans-serif;
    font-size:15px;
    font-weight:600;
    color:var(--copper-light);
    background:rgba(184,112,63,0.15);
    border-radius:10px;
    padding:1px 8px;
    line-height:1.5;
  }
  .waiter-board .waiter-empty{
    font-size:12px;
    color:#8b7f66;
    font-style:italic;
  }

  /* ---------- Layout ---------- */
  main{
    padding:28px 6vw 60px;
    display:grid;
    grid-template-columns:340px 1fr;
    gap:28px;
    align-items:start;
  }
  @media (max-width:880px){
    main{grid-template-columns:1fr;}
  }

  /* ---------- Order pad (form) ---------- */
  .pad{
    background:
      repeating-linear-gradient(#faf7f0 0px, #faf7f0 27px, #f0ebdd 28px);
    color:var(--ink);
    border-radius:2px;
    padding:22px 22px 26px;
    position:sticky;
    top:20px;
    filter:drop-shadow(0 12px 24px rgba(0,0,0,0.35));
  }
  .pad h2{
    font-family:'Oswald',sans-serif;
    font-size:15px;
    font-weight:600;
    letter-spacing:0.14em;
    text-transform:uppercase;
    margin:0 0 14px;
    padding-bottom:8px;
    border-bottom:2px solid var(--ink);
  }
  .field{margin-bottom:12px;}
  .item-rows{display:flex; flex-direction:column; gap:6px; margin-bottom:8px;}
  .item-row-header{
    display:flex; gap:6px; align-items:center;
    font-size:9.5px; letter-spacing:0.08em; text-transform:uppercase; color:#8b7f66;
    padding:0 2px;
  }
  .item-row-header .h-name{flex:1; min-width:0;}
  .item-row-header .h-qty{width:40px; flex:none; text-align:center;}
  .item-row-header .h-rate{width:58px; flex:none; text-align:center;}
  .item-row-header .h-amount{width:64px; flex:none; text-align:center;}
  .item-row-header .h-spacer{width:20px; flex:none;}
  .item-row{display:flex; align-items:center; gap:4px;}
  .item-row .item-name{
    flex:1; min-width:0;
    background:transparent;
    border:none;
    border-bottom:1px dashed #8b7f66;
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:var(--ink);
    padding:4px 2px;
    outline:none;
  }
  .item-row .item-name:focus{border-bottom:1px solid var(--copper);}
  .item-row .item-qty{
    width:40px; flex:none; text-align:center;
    background:transparent;
    border:none;
    border-bottom:1px dashed #8b7f66;
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:var(--ink);
    padding:4px 2px;
    outline:none;
  }
  .item-row .item-qty:focus{border-bottom:1px solid var(--copper);}
  .item-row .item-rate{
    width:58px; flex:none; text-align:center;
    background:transparent;
    border:none;
    border-bottom:1px dashed #8b7f66;
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:var(--ink);
    padding:4px 2px;
    outline:none;
  }
  .item-row .item-rate:focus{border-bottom:1px solid var(--copper);}
  .item-row .item-amount{
    width:64px; flex:none; text-align:right;
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:var(--ink);
    padding:4px 2px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .item-row .item-row-remove{
    flex:none;
    width:22px; height:22px;
    border:none;
    background:transparent;
    color:#a35b52;
    font-size:16px;
    line-height:1;
    cursor:pointer;
    padding:0;
  }
  .item-row .item-row-remove:hover{color:var(--rust);}
  .btn-add-item{
    background:transparent;
    color:var(--copper);
    border:1px dashed var(--copper);
    padding:6px 12px;
    font-size:11px;
  }
  .btn-add-item:hover{background:rgba(184,112,63,0.1);}
  .field label{
    display:block;
    font-size:10.5px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:#5b5140;
    margin-bottom:3px;
  }
  .field input, .field select, .field textarea{
    width:100%;
    background:transparent;
    border:none;
    border-bottom:1px dashed #8b7f66;
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:var(--ink);
    padding:4px 2px;
    outline:none;
  }
  .currency-field{
    display:flex;
    align-items:center;
    gap:4px;
    border-bottom:1px dashed #8b7f66;
  }
  .currency-field .currency-prefix{
    font-family:'IBM Plex Mono',monospace;
    font-size:14px;
    color:#5b5140;
  }
  .currency-field input{
    border-bottom:none;
    padding-left:0;
  }
  .currency-field:focus-within{border-bottom:1px solid var(--copper);}
  .currency-field input[readonly]{color:#5b5140; cursor:default;}
  .totals-block{
    font-size:12px;
    color:#5b5140;
    margin-bottom:6px;
  }
  .totals-block .totals-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:2px 2px;
  }
  .totals-block .totals-input{display:flex; align-items:center; gap:3px;}
  .totals-block .totals-input .currency-prefix{font-size:12px; color:#5b5140;}
  .totals-block .totals-input input{
    width:60px;
    text-align:right;
    background:transparent;
    border:none;
    border-bottom:1px dashed #8b7f66;
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--ink);
    padding:2px;
    outline:none;
  }
  .totals-block .totals-input input:focus{border-bottom:1px solid var(--copper);}
  .field textarea{resize:vertical; min-height:44px;}
  .field input:focus, .field select:focus, .field textarea:focus{border-bottom:1px solid var(--copper);}
  .pad-actions{display:flex; gap:8px; margin-top:16px;}

  button{
    font-family:'Oswald',sans-serif;
    letter-spacing:0.08em;
    text-transform:uppercase;
    font-size:12px;
    font-weight:600;
    border:none;
    border-radius:3px;
    padding:10px 16px;
    cursor:pointer;
    transition:transform .12s ease, filter .12s ease;
  }
  button:active{transform:scale(0.97);}
  button:focus-visible{outline:2px solid var(--copper-light); outline-offset:2px;}
  .btn-primary{background:#0a2647; color:#ffffff; flex:1;}
  .btn-primary:hover{filter:brightness(1.1);}
  .btn-ghost{background:transparent; color:#5b5140; border:1px solid #8b7f66;}
  .btn-ghost:hover{background:rgba(0,0,0,0.06);}
  .btn-stamp{
    background:transparent;
    border:2px solid var(--copper-light);
    color:var(--copper-light);
    border-radius:999px;
    padding:9px 18px;
  }
  .btn-stamp:hover{background:rgba(214,148,99,0.12);}

  /* ---------- Rail controls ---------- */
  .rail-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
    margin-bottom:18px;
  }
  .rail-toolbar input[type=search]{
    background:var(--box-white);
    border:1px solid rgba(7,28,56,0.15);
    border-radius:4px;
    padding:9px 12px;
    color:var(--ink);
    font-family:'IBM Plex Mono',monospace;
    font-size:13px;
    min-width:220px;
  }
  .rail-toolbar input[type=search]:focus{outline:none; border-color:var(--copper);}
  .save-indicator{font-size:11px; color:#7c9473; letter-spacing:0.08em; text-transform:uppercase; opacity:0; transition:opacity .3s;}
  .save-indicator.show{opacity:1;}

  /* ---------- Ticket rail ---------- */
  .rail{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(250px,1fr));
    gap:22px;
  }
  .ticket-wrap{filter:drop-shadow(0 8px 16px rgba(0,0,0,0.4));}
  .ticket{
    background:var(--paper);
    color:var(--ink);
    clip-path:polygon(
      0% 8%,5% 0%,10% 8%,15% 0%,20% 8%,25% 0%,30% 8%,35% 0%,40% 8%,45% 0%,
      50% 8%,55% 0%,60% 8%,65% 0%,70% 8%,75% 0%,80% 8%,85% 0%,90% 8%,95% 0%,
      100% 8%,100% 100%,0% 100%
    );
    padding:26px 18px 18px;
  }
  .ticket .row1{
    display:flex; justify-content:space-between; align-items:baseline;
    border-bottom:1px dashed #8b7f66; padding-bottom:8px; margin-bottom:8px;
  }
  .ticket .oid{font-size:11.5px; font-weight:600; letter-spacing:0.03em;}
  .ticket .odate{font-size:10.5px; color:#5b5140;}
  .ticket .meta{font-size:12px; margin:3px 0;}
  .ticket .meta b{color:#5b5140; font-weight:600;}
  .ticket .items{font-size:12px; margin:8px 0; line-height:1.5; min-height:18px;}
  .ticket .item-line{display:flex; justify-content:space-between; gap:8px;}
  .ticket .item-line .iq{color:#5b5140;}
  .ticket .item-line .iamt{color:#5b5140; flex:none;}
  .ticket .total{
    font-family:'Oswald',sans-serif;
    font-size:20px; font-weight:600;
    margin-top:8px;
  }
  /* Status-tinted ticket cards — lets you scan the sidebar at a glance and
     see which tickets are done vs. still open. */
  .ticket.completed{
    background:linear-gradient(rgba(151,183,127,0.22), rgba(151,183,127,0.22)), var(--paper);
    box-shadow:inset 6px 0 0 var(--sage);
  }
  .ticket.pending{
    background:linear-gradient(rgba(212,163,79,0.18), rgba(212,163,79,0.18)), var(--paper);
    box-shadow:inset 6px 0 0 var(--amber);
  }
  .ticket.ordertaken{
    box-shadow:inset 6px 0 0 var(--copper-light);
  }
  .ticket.cancelled, .ticket.refunded{
    background:linear-gradient(rgba(179,79,63,0.14), rgba(179,79,63,0.14)), var(--paper);
    box-shadow:inset 6px 0 0 var(--rust);
  }
  .badge{
    display:inline-block;
    font-family:'Oswald',sans-serif;
    font-size:10px; letter-spacing:0.1em; text-transform:uppercase;
    padding:3px 8px; border-radius:2px; color:#1c1712; font-weight:600;
  }
  .badge.completed{background:var(--sage);}
  .badge.pending{background:var(--amber);}
  .badge.ordertaken{background:var(--copper-light);}
  .badge.cancelled, .badge.refunded{background:var(--rust); color:#f1e9da;}
  .ticket-actions{
    display:flex; gap:6px; margin-top:14px;
    border-top:1px dashed #8b7f66; padding-top:10px;
  }
  .icon-btn{
    background:transparent; border:1px solid #8b7f66; color:#5b5140;
    font-family:'IBM Plex Mono',monospace; font-size:10.5px; letter-spacing:0.05em;
    text-transform:uppercase; padding:6px 9px; border-radius:2px; flex:1;
  }
  .icon-btn:hover{background:rgba(0,0,0,0.06);}
  .icon-btn.danger{color:var(--rust); border-color:var(--rust);}
  .icon-btn.danger:hover{background:rgba(181,82,75,0.1);}

  .empty{
    grid-column:1/-1;
    text-align:center;
    padding:60px 20px;
    color:#7c7262;
    border:1px dashed var(--line);
    border-radius:6px;
  }
  .empty .display{font-size:16px; color:#a89a80; margin-bottom:6px;}

  footer{
    padding:18px 6vw 40px;
    color:#6b6252;
    font-size:11px;
    letter-spacing:0.05em;
  }

  .visually-hidden{
    position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0);
  }

  /* ---------- New-ticket pop-up alerts ---------- */
  .alerts-container{
    position:fixed;
    top:16px;
    right:16px;
    left:16px;
    z-index:1000;
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:10px;
    pointer-events:none;
  }
  .alert-card{
    pointer-events:auto;
    width:min(340px, 100%);
    background:var(--copper);
    color:#1c1712;
    border-radius:6px;
    padding:12px 34px 12px 14px;
    position:relative;
    filter:drop-shadow(0 10px 20px rgba(0,0,0,0.45));
    animation:alert-in 0.28s cubic-bezier(.2,.9,.3,1.3);
  }
  .alert-card.leaving{ animation:alert-out 0.25s ease forwards; }
  @keyframes alert-in{
    from{ transform:translateY(-16px); opacity:0; }
    to{ transform:translateY(0); opacity:1; }
  }
  @keyframes alert-out{
    to{ transform:translateX(24px); opacity:0; }
  }
  .alert-head{
    font-family:'Oswald',sans-serif;
    font-size:11.5px;
    font-weight:700;
    letter-spacing:0.1em;
    text-transform:uppercase;
    margin-bottom:4px;
  }
  .alert-body{
    font-family:'IBM Plex Mono',monospace;
    font-size:12.5px;
    line-height:1.5;
  }
  .alert-amount{
    font-family:'Oswald',sans-serif;
    font-size:17px;
    font-weight:600;
    margin-top:2px;
  }
  .alert-dismiss{
    position:absolute;
    top:8px;
    right:8px;
    background:transparent;
    border:none;
    color:#1c1712;
    font-size:18px;
    line-height:1;
    padding:4px;
    cursor:pointer;
  }
  @media (prefers-reduced-motion: reduce){
    .alert-card, .alert-card.leaving{ animation:none; }
  }

  /* ---------- Auth: login gate & staff management ---------- */
  .app-hidden{ display:none !important; }
  .auth-overlay{
    position:fixed; inset:0; z-index:9999;
    display:flex; align-items:center; justify-content:center;
    background:
      radial-gradient(ellipse at 20% -10%, #123a6b 0%, transparent 55%),
      #071c38;
    padding:24px;
    overflow-y:auto;
  }
  .auth-card{
    background: repeating-linear-gradient(#faf7f0 0px, #faf7f0 27px, #f0ebdd 28px);
    color:var(--ink);
    width:100%; max-width:400px;
    border-radius:2px;
    padding:30px 26px 26px;
    filter:drop-shadow(0 12px 24px rgba(0,0,0,0.35));
  }
  .auth-card h2{
    font-family:'Oswald',sans-serif; font-size:19px; margin:0 0 4px;
    color:#1c1712; text-transform:uppercase; letter-spacing:0.04em;
  }
  .auth-card h2 span{ color:var(--copper); }
  .auth-card p.auth-sub{
    font-size:11.5px; color:#8b7f66; margin:0 0 18px; letter-spacing:0.03em;
  }
  .auth-card label{
    display:block; font-size:10px; text-transform:uppercase; letter-spacing:0.09em;
    color:#5b5140; margin:12px 0 4px; font-family:'Oswald',sans-serif;
  }
  .auth-card input, .auth-card select{
    width:100%; padding:9px 10px; border:1px solid rgba(43,38,32,0.25);
    border-radius:3px; font-family:'IBM Plex Mono',monospace; font-size:13.5px;
    background:#fff; color:var(--ink);
  }
  .auth-card input:focus, .auth-card select:focus{
    outline:2px solid var(--copper-light); outline-offset:1px;
  }
  .auth-error{ color:var(--rust); font-size:11.5px; margin-top:10px; min-height:14px; }
  .auth-card .btn-primary{ width:100%; margin-top:16px; }
  .auth-hint{
    margin-top:16px; font-size:10.5px; color:#8b7f66; line-height:1.5;
    border-top:1px dashed rgba(43,38,32,0.2); padding-top:12px;
  }
  .user-bar{ display:flex; align-items:center; gap:10px; }
  .user-bar .who{ font-size:11.5px; color:#a89a80; text-align:right; line-height:1.4; }
  .user-bar .who b{ color:var(--paper); font-weight:600; }
  .role-tag{
    text-transform:uppercase; letter-spacing:0.08em; font-size:9px;
    padding:2px 7px; border-radius:10px; background:rgba(184,112,63,0.22);
    color:var(--copper-light); margin-left:6px;
  }
  .user-bar .btn-ghost{
    padding:7px 12px; font-size:11px; border-color:#5b5140; color:#d9cfba;
    background:transparent;
  }
  .user-bar .btn-ghost:hover{ background:rgba(255,255,255,0.08); }
  .staff-row{
    display:flex; align-items:center; justify-content:space-between;
    gap:10px; padding:8px 0; border-bottom:1px solid rgba(43,38,32,0.12);
    font-size:12.5px;
  }
  .staff-row:last-child{ border-bottom:none; }
  .staff-row .staff-name{ display:flex; align-items:center; gap:2px; }
  .staff-row button{
    background:transparent; border:1px solid rgba(181,82,75,0.5); color:var(--rust);
    border-radius:3px; font-size:10.5px; padding:4px 8px; cursor:pointer;
  }
  .staff-row button:hover{ background:rgba(181,82,75,0.1); }
  .staff-empty{ font-size:11.5px; color:#8b7f66; font-style:italic; padding:6px 0; }
</style>
</head>
<body>

<div id="alerts" class="alerts-container" aria-live="polite"></div>

<div id="login-overlay" class="auth-overlay">
  <div class="auth-card">
    <h2>BHLI-TMOI <span>Restaurant</span></h2>
    <p class="auth-sub">Sign in with your staff or admin login to open the order board.</p>
    <form id="login-form" autocomplete="off">
      <label for="login-username">Login ID</label>
      <input type="text" id="login-username" autocomplete="username" required>
      <label for="login-password">Password</label>
      <input type="password" id="login-password" autocomplete="current-password" required>
      <div class="auth-error" id="login-error"></div>
      <button type="submit" class="btn-primary">Sign In</button>
    </form>
    <div class="auth-hint">Default admin login: <strong>admin / admin123</strong>. Sign in as admin and open <strong>Manage Staff</strong> to create staff logins and change passwords.</div>
  </div>
</div>

<div id="manage-staff-overlay" class="auth-overlay app-hidden" style="z-index:10000;">
